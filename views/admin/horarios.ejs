<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <h1 class="h3 mb-1">Horarios</h1>
        <p class="text-muted mb-4">Crear, editar y eliminar horarios.</p>

        <div id="admin-feedback" class="alert d-none" role="alert"></div>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Formulario</h2>
                <form id="form-horarios" class="row g-3">
                    <input type="hidden" id="horario-id">
                    <div class="col-md-4">
                        <label class="form-label" for="horario-cancha">Cancha</label>
                        <select class="form-select" id="horario-cancha" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="horario-fecha">Fecha</label>
                        <input class="form-control" id="horario-fecha" type="date" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="horario-inicio">Inicio</label>
                        <input class="form-control" id="horario-inicio" type="time" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="horario-fin">Fin</label>
                        <input class="form-control" id="horario-fin" type="time" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="horario-disponible">Disponible</label>
                        <select class="form-select" id="horario-disponible" required>
                            <option value="true">Sí</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Guardar</button>
                        <button class="btn btn-outline-secondary" id="cancelar-edicion-horarios" type="button">Cancelar edición</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Listado</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Cancha ID</th>
                                <th>Fecha</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Disponible</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-horarios-body">
                            <tr><td colspan="7" class="text-center text-muted py-3">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer', { pageScript }) %>
</body>
</html>
