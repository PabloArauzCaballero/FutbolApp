<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <h1 class="h3 mb-1">Horarios</h1>
        <p class="text-muted mb-4">Crear, editar y eliminar horarios.</p>

        <% if (feedback && feedback.message) { %>
            <div class="alert alert-<%= feedback.type %>" role="alert"><%= feedback.message %></div>
        <% } %>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Formulario</h2>
                <form class="row g-3" method="post" action="<%= editItem ? `${currentPath}/update/${editItem.id}` : `${currentPath}/create` %>">
                    <div class="col-md-4">
                        <label class="form-label" for="horario-cancha">Cancha</label>
                        <select class="form-select" id="horario-cancha" name="cancha_id" required>
                            <% (canchas || []).forEach((cancha) => { %>
                                <option value="<%= cancha.id %>" <%= editItem && Number(editItem.cancha_id) === Number(cancha.id) ? 'selected' : '' %>>
                                    <%= cancha.id %> - <%= cancha.nombre %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="horario-fecha">Fecha</label>
                        <input class="form-control" id="horario-fecha" name="fecha" type="date" required value="<%= editItem ? editItem.fecha : '' %>">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="horario-inicio">Inicio</label>
                        <input class="form-control" id="horario-inicio" name="hora_inicio" type="time" required value="<%= editItem ? String(editItem.hora_inicio || '').slice(0,5) : '' %>">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="horario-fin">Fin</label>
                        <input class="form-control" id="horario-fin" name="hora_fin" type="time" required value="<%= editItem ? String(editItem.hora_fin || '').slice(0,5) : '' %>">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="horario-disponible">Disponible</label>
                        <select class="form-select" id="horario-disponible" name="disponible" required>
                            <option value="true" <%= editItem && editItem.disponible ? 'selected' : '' %>>Sí</option>
                            <option value="false" <%= editItem && !editItem.disponible ? 'selected' : '' %>>No</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit"><%= editItem ? 'Actualizar' : 'Crear' %></button>
                        <% if (editItem) { %>
                            <a class="btn btn-outline-secondary" href="<%= currentPath %>">Cancelar edición</a>
                        <% } %>
                    </div>
                </form>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Listado</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Cancha ID</th>
                                <th>Fecha</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Disponible</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-horarios-body">
                            <% if (!horarios || horarios.length === 0) { %>
                                <tr><td colspan="7" class="text-center text-muted py-3">No hay registros.</td></tr>
                            <% } %>
                            <% (horarios || []).forEach((item) => { %>
                                <tr>
                                    <td><%= item.id %></td>
                                    <td><%= item.cancha_id %></td>
                                    <td><%= item.fecha %></td>
                                    <td><%= item.hora_inicio %></td>
                                    <td><%= item.hora_fin %></td>
                                    <td><%= item.disponible ? 'Sí' : 'No' %></td>
                                    <td class="d-flex gap-2">
                                        <a class="btn btn-sm btn-outline-primary" href="<%= `${currentPath}?edit=${item.id}` %>">Editar</a>
                                        <form method="post" action="<%= `${currentPath}/delete/${item.id}` %>" onsubmit="return confirm('¿Eliminar este horario?')">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
