<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <section class="mb-4">
            <h1 class="h3 mb-1"><%= pageConfig.title %></h1>
            <p class="text-muted mb-0"><%= pageConfig.description %></p>
        </section>

        <%- include('../fragments/crud-form', { pageConfig }) %>
        <%- include('../fragments/crud-table', { pageConfig }) %>
    </main>

    <script>
        window.__APP_CONFIG__ = <%- JSON.stringify(appConfig) %>;
        window.__CRUD_CONFIG__ = <%- JSON.stringify(pageConfig) %>;
    </script>
    <%- include('../partials/footer', { pageScript: '/public/js/app.js' }) %>
</body>
</html>
