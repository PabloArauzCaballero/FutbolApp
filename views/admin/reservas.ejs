<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <h1 class="h3 mb-1">Reservas</h1>
        <p class="text-muted mb-4">Crear, editar y eliminar reservas.</p>

        <% if (feedback && feedback.message) { %>
            <div class="alert alert-<%= feedback.type %>" role="alert"><%= feedback.message %></div>
        <% } %>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Formulario</h2>
                <form class="row g-3" method="post" action="<%= editItem ? `${currentPath}/update/${editItem.id}` : `${currentPath}/create` %>">
                    <div class="col-md-4">
                        <label class="form-label" for="reserva-usuario">Usuario</label>
                        <select class="form-select" id="reserva-usuario" name="usuario_id" required>
                            <% (usuarios || []).forEach((usuario) => { %>
                                <option value="<%= usuario.id %>" <%= editItem && Number(editItem.usuario_id) === Number(usuario.id) ? 'selected' : '' %>>
                                    <%= usuario.id %> - <%= usuario.email %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="reserva-horario">Horario</label>
                        <select class="form-select" id="reserva-horario" name="horario_id" required>
                            <% (horarios || []).forEach((horario) => { %>
                                <option value="<%= horario.id %>" <%= editItem && Number(editItem.horario_id) === Number(horario.id) ? 'selected' : '' %>>
                                    <%= horario.id %> - <%= horario.fecha %> <%= String(horario.hora_inicio || '').slice(0,5) %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="reserva-estado">Estado</label>
                        <select class="form-select" id="reserva-estado" name="estado" required>
                            <option value="confirmada" <%= editItem && editItem.estado === 'confirmada' ? 'selected' : '' %>>Confirmada</option>
                            <option value="cancelada" <%= editItem && editItem.estado === 'cancelada' ? 'selected' : '' %>>Cancelada</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit"><%= editItem ? 'Actualizar' : 'Crear' %></button>
                        <% if (editItem) { %>
                            <a class="btn btn-outline-secondary" href="<%= currentPath %>">Cancelar edición</a>
                        <% } %>
                    </div>
                </form>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Listado</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Usuario ID</th>
                                <th>Horario ID</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-reservas-body">
                            <% if (!reservas || reservas.length === 0) { %>
                                <tr><td colspan="5" class="text-center text-muted py-3">No hay registros.</td></tr>
                            <% } %>
                            <% (reservas || []).forEach((item) => { %>
                                <tr>
                                    <td><%= item.id %></td>
                                    <td><%= item.usuario_id %></td>
                                    <td><%= item.horario_id %></td>
                                    <td><%= item.estado %></td>
                                    <td class="d-flex gap-2">
                                        <a class="btn btn-sm btn-outline-primary" href="<%= `${currentPath}?edit=${item.id}` %>">Editar</a>
                                        <form method="post" action="<%= `${currentPath}/delete/${item.id}` %>" onsubmit="return confirm('¿Eliminar esta reserva?')">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
