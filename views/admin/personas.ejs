<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <h1 class="h3 mb-1">Usuarios</h1>
        <p class="text-muted mb-4">Registrar, editar y eliminar usuarios.</p>

        <% if (feedback && feedback.message) { %>
            <div class="alert alert-<%= feedback.type %>" role="alert"><%= feedback.message %></div>
        <% } %>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Formulario</h2>
                <form class="row g-3" method="post" action="<%= editItem ? `${currentPath}/update/${editItem.id}` : `${currentPath}/create` %>">
                    <div class="col-md-6">
                        <label class="form-label" for="persona-nombre">Nombre</label>
                        <input class="form-control" id="persona-nombre" name="nombre" required value="<%= editItem ? editItem.nombre : '' %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="persona-email">Correo</label>
                        <input class="form-control" id="persona-email" name="email" type="email" required value="<%= editItem ? editItem.email : '' %>">
                    </div>
                    <% if (!editItem) { %>
                        <div class="col-md-6" id="persona-password-wrapper">
                            <label class="form-label" for="persona-password">Contraseña</label>
                            <input class="form-control" id="persona-password" name="contrasena" type="password" required>
                        </div>
                    <% } %>
                    <div class="col-md-6">
                        <label class="form-label" for="persona-rol">Rol</label>
                        <select class="form-select" id="persona-rol" name="rol" required>
                            <option value="admin" <%= editItem && editItem.rol === 'admin' ? 'selected' : '' %>>Admin</option>
                            <option value="cliente" <%= editItem && editItem.rol === 'cliente' ? 'selected' : '' %>>Cliente</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit"><%= editItem ? 'Actualizar' : 'Crear' %></button>
                        <% if (editItem) { %>
                            <a class="btn btn-outline-secondary" href="<%= currentPath %>">Cancelar edición</a>
                        <% } %>
                    </div>
                </form>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Listado</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Rol</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-personas-body">
                            <% if (!personas || personas.length === 0) { %>
                                <tr><td colspan="5" class="text-center text-muted py-3">No hay registros.</td></tr>
                            <% } %>
                            <% (personas || []).forEach((item) => { %>
                                <tr>
                                    <td><%= item.id %></td>
                                    <td><%= item.nombre %></td>
                                    <td><%= item.email %></td>
                                    <td><%= item.rol %></td>
                                    <td class="d-flex gap-2">
                                        <a class="btn btn-sm btn-outline-primary" href="<%= `${currentPath}?edit=${item.id}` %>">Editar</a>
                                        <form method="post" action="<%= `${currentPath}/delete/${item.id}` %>" onsubmit="return confirm('¿Eliminar este usuario?')">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
