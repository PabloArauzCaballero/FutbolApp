<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <h1 class="h3 mb-1">Usuarios</h1>
        <p class="text-muted mb-4">Registrar, editar y eliminar usuarios.</p>

        <div id="admin-feedback" class="alert d-none" role="alert"></div>

        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Formulario</h2>
                <form id="form-personas" class="row g-3">
                    <input type="hidden" id="persona-id">
                    <div class="col-md-6">
                        <label class="form-label" for="persona-nombre">Nombre</label>
                        <input class="form-control" id="persona-nombre" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="persona-email">Correo</label>
                        <input class="form-control" id="persona-email" type="email" required>
                    </div>
                    <div class="col-md-6" id="persona-password-wrapper">
                        <label class="form-label" for="persona-password">Contraseña</label>
                        <input class="form-control" id="persona-password" type="password">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="persona-rol">Rol</label>
                        <select class="form-select" id="persona-rol" required>
                            <option value="admin">Admin</option>
                            <option value="cliente">Cliente</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-primary" type="submit">Guardar</button>
                        <button class="btn btn-outline-secondary" id="cancelar-edicion-personas" type="button">Cancelar edición</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Listado</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Rol</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-personas-body">
                            <tr><td colspan="5" class="text-center text-muted py-3">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer', { pageScript }) %>
</body>
</html>
