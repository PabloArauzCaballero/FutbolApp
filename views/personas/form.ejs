<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-content">
        <div class="page-header">
            <h1><%= isEdit ? 'Editar Usuario' : 'Nuevo Usuario' %></h1>
            <a href="/personas" class="btn btn-outline">Volver</a>
        </div>

        <% if (error) { %>
            <div class="flash error"><%= error %></div>
        <% } %>

        <div class="card" style="max-width:500px;">
            <form method="POST" action="<%= isEdit ? '/personas/' + persona.id + '/editar' : '/personas/nueva' %>">
                <div class="form-group">
                    <label for="nombre">Nombre completo</label>
                    <input type="text" id="nombre" name="nombre" required
                           value="<%= persona ? persona.nombre : '' %>">
                </div>
                <div class="form-group">
                    <label for="email">Correo electrónico</label>
                    <input type="email" id="email" name="email" required
                           value="<%= persona ? persona.email : '' %>">
                </div>
                <div class="form-group">
                    <label for="contrasena">
                        <%= isEdit ? 'Nueva contraseña (dejar vacío para mantener)' : 'Contraseña' %>
                    </label>
                    <input type="password" id="contrasena" name="contrasena"
                           <%= isEdit ? '' : 'required' %>>
                </div>
                <div class="form-group">
                    <label for="rol">Rol</label>
                    <select id="rol" name="rol" required>
                        <option value="cliente" <%= persona && persona.rol === 'cliente' ? 'selected' : '' %>>Cliente</option>
                        <option value="admin" <%= persona && persona.rol === 'admin' ? 'selected' : '' %>>Administrador</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success" style="width:100%;">
                    <%= isEdit ? 'Actualizar' : 'Crear' %> Usuario
                </button>
            </form>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
