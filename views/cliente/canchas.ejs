<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <section class="mb-4">
            <h1 class="h3 mb-1">Canchas disponibles</h1>
            <p class="text-muted mb-0">Selecciona una cancha y reserva un horario disponible.</p>
        </section>

        <% if (feedback && feedback.message) { %>
            <div class="alert alert-<%= feedback.type %>" role="alert"><%= feedback.message %></div>
        <% } %>

        <section class="mb-4">
            <div class="row">
                <% if (!canchas || canchas.length === 0) { %>
                    <div class="col-12 text-muted">No hay canchas activas.</div>
                <% } %>
                <% (canchas || []).forEach((cancha) => { %>
                    <% const tipo = tiposById ? tiposById.get(Number(cancha.tipo_id)) : null; %>
                    <div class="col-md-6 col-xl-4 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h3 class="h5 card-title mb-2"><%= cancha.nombre %></h3>
                                <p class="mb-1"><strong>Tipo:</strong> <%= tipo ? tipo.nombre : `Tipo ${cancha.tipo_id}` %></p>
                                <p class="mb-2"><strong>Precio/hora:</strong> Bs. <%= cancha.precio_por_hora %></p>
                                <span class="badge bg-success">activa</span>
                            </div>
                            <div class="card-footer bg-white">
                                <a class="btn btn-primary btn-sm" href="/cliente/canchas/<%= cancha.id %>">Ver horarios</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <% if (selectedCancha) { %>
            <section class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div>
                            <h2 class="h5 mb-1">Horarios de <%= selectedCancha.nombre %></h2>
                            <p class="text-muted mb-0">Reserva un horario disponible.</p>
                        </div>
                        <form method="get" action="/cliente/canchas/<%= selectedCancha.id %>" class="d-flex align-items-end gap-2">
                            <div>
                                <label for="filtro-fecha" class="form-label mb-1">Filtrar por fecha</label>
                                <input type="date" id="filtro-fecha" name="fecha" value="<%= selectedFecha || '' %>" class="form-control">
                            </div>
                            <button class="btn btn-outline-secondary" type="submit">Filtrar</button>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha</th>
                                    <th>Inicio</th>
                                    <th>Fin</th>
                                    <th>Disponible</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!horariosDisponibles || horariosDisponibles.length === 0) { %>
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-3">No hay horarios disponibles.</td>
                                    </tr>
                                <% } %>
                                <% (horariosDisponibles || []).forEach((horario) => { %>
                                    <tr>
                                        <td><%= horario.id %></td>
                                        <td><%= horario.fecha %></td>
                                        <td><%= String(horario.hora_inicio || '').slice(0,5) %></td>
                                        <td><%= String(horario.hora_fin || '').slice(0,5) %></td>
                                        <td><span class="badge bg-success">Sí</span></td>
                                        <td>
                                            <form method="post" action="/cliente/reservas/create" onsubmit="return confirm('¿Confirmar reserva?')">
                                                <input type="hidden" name="horario_id" value="<%= horario.id %>">
                                                <button class="btn btn-sm btn-primary" type="submit">Reservar</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Reseñas de <%= selectedCancha.nombre %></h2>
                    <% if (!resenasCancha || resenasCancha.length === 0) { %>
                        <p class="text-muted mb-0">Esta cancha todavía no tiene reseñas.</p>
                    <% } %>
                    <% (resenasCancha || []).forEach((resena) => { %>
                        <div class="border rounded p-3 mb-2">
                            <div class="mb-1"><strong>Calificación:</strong> <%= resena.calificacion %>/5</div>
                            <p class="mb-0"><%= resena.comentario %></p>
                        </div>
                    <% }) %>
                </div>
            </section>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
