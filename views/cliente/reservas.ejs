<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head', { appConfig, pageTitle }) %>
</head>
<body>
    <%- include('../partials/navbar', { appConfig, navigationItems, currentUser, currentPath }) %>

    <main class="container py-4">
        <section class="mb-4">
            <h1 class="h3 mb-1">Mis reservas</h1>
            <p class="text-muted mb-0">Aquí puedes ver tu historial y cancelar reservas confirmadas.</p>
        </section>

        <% if (feedback && feedback.message) { %>
            <div class="alert alert-<%= feedback.type %>" role="alert"><%= feedback.message %></div>
        <% } %>

        <section class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID Reserva</th>
                                <th>ID Horario</th>
                                <th>Fecha</th>
                                <th>Hora Inicio</th>
                                <th>Hora Fin</th>
                                <th>Cancha</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!reservas || reservas.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-3">No tienes reservas registradas.</td>
                                </tr>
                            <% } %>
                            <% (reservas || []).forEach((reserva) => { %>
                                <tr>
                                    <td><%= reserva.id %></td>
                                    <td><%= reserva.horario_id %></td>
                                    <td><%= reserva.horario ? reserva.horario.fecha : '-' %></td>
                                    <td><%= reserva.horario ? String(reserva.horario.hora_inicio || '').slice(0,5) : '-' %></td>
                                    <td><%= reserva.horario ? String(reserva.horario.hora_fin || '').slice(0,5) : '-' %></td>
                                    <td><%= reserva.cancha ? reserva.cancha.nombre : '-' %></td>
                                    <td>
                                        <span class="badge <%= reserva.estado === 'confirmada' ? 'bg-success' : 'bg-secondary' %>">
                                            <%= reserva.estado %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (reserva.estado === 'confirmada') { %>
                                            <form method="post" action="/cliente/reservas/<%= reserva.id %>/cancelar" onsubmit="return confirm('¿Cancelar esta reserva?')">
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Cancelar</button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-muted">-</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
