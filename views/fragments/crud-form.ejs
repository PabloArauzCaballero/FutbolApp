<div class="card crud-card mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h4 section-title mb-1">Formulario</h2>
                <p class="text-muted mb-0">Completa los datos y guarda el registro.</p>
            </div>
            <span id="crud-mode-badge" class="badge text-bg-primary">Modo creación</span>
        </div>

        <div id="crud-feedback" class="alert d-none" role="alert"></div>

        <form id="crud-form" class="row g-3">
            <input type="hidden" id="crud-current-id" name="crud-current-id">

            <% pageConfig.formFields.forEach((field) => { %>
                <div class="col-md-6" data-only-on-create="<%= field.onlyOnCreate ? 'true' : 'false' %>">
                    <label for="field-<%= field.name %>" class="form-label"><%= field.label %></label>

                    <% if (field.type === 'textarea') { %>
                        <textarea
                            class="form-control"
                            id="field-<%= field.name %>"
                            name="<%= field.name %>"
                            rows="<%= field.rows || 3 %>"
                            <%= field.required ? 'required' : '' %>
                        ></textarea>
                    <% } else if (field.type === 'select') { %>
                        <select
                            class="form-select"
                            id="field-<%= field.name %>"
                            name="<%= field.name %>"
                            <%= field.required ? 'required' : '' %>
                        >
                            <option value="">Seleccione una opción</option>
                            <% (field.options || []).forEach((option) => { %>
                                <option value="<%= option.value %>"><%= option.label %></option>
                            <% }) %>
                        </select>
                    <% } else { %>
                        <input
                            class="form-control"
                            id="field-<%= field.name %>"
                            name="<%= field.name %>"
                            type="<%= field.type || 'text' %>"
                            placeholder="<%= field.placeholder || '' %>"
                            <%= field.required ? 'required' : '' %>
                            <%= field.min ? `min="${field.min}"` : '' %>
                            <%= field.max ? `max="${field.max}"` : '' %>
                            <%= field.step ? `step="${field.step}"` : '' %>
                        >
                    <% } %>
                </div>
            <% }) %>

            <div class="col-12 d-flex gap-2">
                <button id="crud-submit-button" type="submit" class="btn btn-primary">Guardar</button>
                <button id="crud-cancel-edit" type="button" class="btn btn-outline-secondary d-none">Cancelar edición</button>
                <button id="crud-reload-button" type="button" class="btn btn-outline-dark">Recargar</button>
            </div>
        </form>
    </div>
</div>
