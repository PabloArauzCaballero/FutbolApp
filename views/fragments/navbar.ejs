<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" href="<%= appConfig.homePath %>"><%= appConfig.brand %></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <% navigationItems.forEach((item) => { %>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link <%= currentPath === item.href ? 'active' : '' %>" href="<%= item.href %>"><%= item.title %></a>
                    </li>
                <% }) %>
            </ul>
            <div class="d-flex align-items-center gap-3">
                <% if (currentUser) { %>
                    <div class="text-end small">
                        <div class="fw-semibold"><%= currentUser.nombre || currentUser.email %></div>
                        <div class="text-muted"><%= currentUser.rol || 'usuario' %></div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm" data-action="logout">Cerrar sesión</button>
                <% } %>
            </div>
        </div>
    </div>
</nav>
