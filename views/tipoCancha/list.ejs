<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-content">
        <div class="page-header">
            <h1>Tipos de Cancha</h1>
            <a href="/tipoCancha/nueva" class="btn btn-success">+ Nuevo Tipo</a>
        </div>

        <% if (flash && flash.success) { %>
            <div class="flash success"><%= flash.success %></div>
        <% } %>
        <% if (flash && flash.error) { %>
            <div class="flash error"><%= flash.error %></div>
        <% } %>

        <div class="card">
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% tipos.forEach(function(t) { %>
                        <tr>
                            <td><%= t.id %></td>
                            <td><%= t.nombre %></td>
                            <td>
                                <a href="/tipoCancha/<%= t.id %>/editar" class="btn btn-outline" style="padding:0.2rem 0.5rem; font-size:0.8rem;">Editar</a>
                                <a href="/tipoCancha/<%= t.id %>/eliminar" class="btn btn-danger" style="padding:0.2rem 0.5rem; font-size:0.8rem;"
                                   onclick="return confirm('Eliminar este tipo de cancha?');">Eliminar</a>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <% if (tipos.length === 0) { %>
                <p style="text-align:center; padding:2rem; color:var(--text-muted);">No hay tipos de cancha registrados.</p>
            <% } %>
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
