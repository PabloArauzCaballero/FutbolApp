<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../fragments/head', { pageTitle: `${appConfig.brand} | ${pageConfig.title}` }) %>
</head>
<body>
    <%- include('../fragments/navbar', { appConfig, navigationItems, currentUser, currentPath: pageConfig.viewBasePath }) %>

    <main class="container py-4">
        <div class="mb-4">
            <p class="text-uppercase text-muted small mb-2">Panel CRUD</p>
            <h1 class="display-6 fw-bold mb-2"><%= pageConfig.title %></h1>
            <p class="text-muted mb-0"><%= pageConfig.description %></p>
        </div>

        <%- include('../fragments/crud-form', { pageConfig }) %>
        <%- include('../fragments/crud-table', { pageConfig }) %>
    </main>

    <script>
        window.__APP_CONFIG__ = <%- JSON.stringify(appConfig) %>;
        window.__CRUD_CONFIG__ = <%- JSON.stringify(pageConfig) %>;
    </script>
    <%- include('../fragments/footer-scripts') %>
    <script src="/public/js/app.js"></script>
</body>
</html>
