<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="main-content">
        <% if (typeof flash !== 'undefined' && flash) { %>
            <% if (flash.success) { %>
                <div class="flash success"><%= flash.success %></div>
            <% } %>
            <% if (flash.error) { %>
                <div class="flash error"><%= flash.error %></div>
            <% } %>
        <% } %>
        <%- body %>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>
